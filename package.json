{
    "name": "tg-bot",
    "version": "1.0.0",
    "description": "Телеграм бот для автоматизации рабочих сообщений в телеграм чатах",
    "author": "Dmitriev Yaroslav",
    "scripts": {
        "start": "nodemon --watch ./src/**/*.ts --exec \"tsc --build && node --env-file=.env dist/index.js\"",
        "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.mjs"
    },
    "dependencies": {
        "@sequelize/core": "^7.0.0-alpha.42",
        "@sequelize/postgres": "^7.0.0-alpha.43",
        "dotenv": "^16.4.5",
        "telegraf": "^4.16.3"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "concurrently": "^9.1.2",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2"
    }
}
